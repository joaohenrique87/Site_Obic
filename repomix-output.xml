.btn-visualizar,
.btn-baixar {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  padding: 0.5rem 0.75rem;
  border-radius: 8px;
  font-size: 0.82rem;
  font-family: 'Cambria', serif;
  font-weight: 600;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: opacity 0.2s ease;
  white-space: nowrap;
}

.btn-visualizar:hover,
.btn-baixar:hover {
  opacity: 0.85;
}

.btn-visualizar {
  background: #6d28d9;
  color: #fff;
}

.btn-baixar {
  background: #16a34a;
  color: #fff;
}

/* Loader */
.loader {
  text-align: center;
  padding: 2rem;
  font-family: 'Cambria', serif;
  color: #666;
