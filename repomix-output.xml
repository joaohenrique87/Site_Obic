  left: 0;
}

.capa-erro {
  background: #fdecea;
  color: #c0392b;
  font-size: 1.2rem;
  font-weight: bold;
}

/* Info */
.card-info {
  padding: 1rem 1.2rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.card-info h3 {
  font-size: 0.9rem;
  font-family: sans-serif;
  font-weight: 600;
  color: #1a1a1a;
  margin: 0;
