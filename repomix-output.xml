<file path="src/Carrossel.css">
/* Container geral */
.container-carrossel {
  width: 100%;
  overflow: hidden;
}

/* Wrapper com setas */
.carrossel-wrapper {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
}

/* Viewport — janela visível, não pode vazar */
.carrossel-viewport {
  flex: 1;
  overflow: hidden;
  min-width: 0;
}

/* Faixa deslizante */
.carrossel-faixa {
  display: flex;
  transition: transform 0.4s ease;
  will-change: transform;
}

/* Item individual — largura exata de 25% para mostrar 4 */
.carrossel-item {
  flex: 0 0 25%;
  min-width: 0;
  padding: 0 0.4rem;
  box-sizing: border-box;
}

/* Setas */
.seta {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: none;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 1.2rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease;
  z-index: 1;
}

.seta:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.4);
}

.seta:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}

/* Card */
.card-relatorio {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  height: 100%;
}

.card-relatorio:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
}

/* Capa */
.card-capa {
  width: 100%;
  height: 300px;
  overflow: hidden;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.capa-canvas {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover;
  display: block;
}

.capa-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8e8e8;
  color: #999;
  font-size: 0.9rem;
  font-family: sans-serif;
  position: absolute;
